# GEMINI_API_KEY: Required for Gemini AI API calls. (Optional: Demo AI works if absent)
GEMINI_API_KEY=

# Configurable Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/codemate).
# If left empty, CodeMate AI automatically uses its robust built-in local persistent SQL database.
DATABASE_URL=

# JWT Secret for secure authentication token signing
JWT_SECRET=codemate-ai-super-secure-jwt-secret-key-2026

# Server port (fixed to 3000 in container environment)
PORT=3000

# Node environment
NODE_ENV=development

